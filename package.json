{
  "name": "@gum-jsx/cli",
  "description": "Command-line rendering for gum-jsx.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "gum": "src/cli.ts",
    "gum-tex": "src/tex.ts",
    "gum-mark": "src/mark.ts"
  },
  "scripts": {
    "gum": "bun src/cli.ts",
    "gum-mark": "bun src/mark.ts",
    "typecheck": "tsc --noEmit",
    "gum-tex": "bun src/tex.ts",
    "test": "bun test ./test",
    "visual-test": "bun test/visual.ts",
    "visual-report": "bun test/visual.ts",
    "visual-report:serve": "bun visual-report/serve.ts"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "@gum-jsx/core": "workspace:*",
    "@gum-jsx/math": "workspace:*",
    "@gum-jsx/mark": "workspace:*",
    "@gum-jsx/pdf": "workspace:*",
    "@gum-jsx/png": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
