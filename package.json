{
  "name": "gum-jsx-cli",
  "version": "0.1.0",
  "description": "Command-line rendering for gum-next.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "gum": "src/cli.ts",
    "gum-tex": "src/tex.ts"
  },
  "scripts": {
    "gum": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "gum-tex": "bun src/tex.ts",
    "test": "bun test",
    "visual-test": "bun scripts/visual-test.ts",
    "visual-report": "bun scripts/visual-test.ts",
    "visual-report:serve": "bun visual-report/serve.ts"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "gum-next-core": "workspace:*",
    "gum-next-math": "workspace:*",
    "gum-next-png": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
