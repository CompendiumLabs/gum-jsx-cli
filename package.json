{
  "name": "@gum-jsx/cli",
  "description": "Command-line rendering for gum-jsx.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gum": "dist/npm/cli.js"
  },
  "scripts": {
    "build:standalone": "bun scripts/standalone.ts",
    "pack:standalone": "bun scripts/standalone.ts --archive",
    "gum": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "visual-test": "bun test/visual.ts",
    "visual-report": "bun test/visual.ts",
    "visual-report:serve": "bun visual-report/serve.ts",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "fast-png": "^8.0.0",
    "@types/bun": "latest",
    "typescript": "^7",
    "commander": "^14.0.3",
    "@gum-jsx/core": "2.0.0-beta.3",
    "@gum-jsx/math": "2.0.0-beta.3",
    "@gum-jsx/maps": "2.0.0-beta.3",
    "@gum-jsx/pdf": "2.0.0-beta.3",
    "@gum-jsx/png": "2.0.0-beta.3"
  },
  "version": "2.0.0-beta.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-cli.git"
  },
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-cli#readme",
  "bugs": {
    "url": "https://github.com/CompendiumLabs/gum-jsx-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "files": [
    "dist/npm",
    "README.md",
    "LICENSE"
  ]
}
